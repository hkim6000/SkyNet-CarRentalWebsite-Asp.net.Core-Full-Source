    "policies": {
      "blocks": [
        {
          "id": "b4dggcsr3s",
          "type": "text",
          "source": "",
          "hidden": false,
          "kicker": "Rental policies",
          "title": "The rules, in plain words",
          "text": "<p>These are the terms every rental follows. If something is unclear, ask us before you book.</p>",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
          "items": []
        },
        {
          "id": "b49umeiq8e",
          "type": "faq",
          "source": "",
          "hidden": false,
          "kicker": "",
          "title": "Drivers and payment",
          "text": "",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
          "items": [
            {
              "icon": "",
              "media": "",
              "title": "Driver age and licence",
              "text": "The main driver and every additional driver must be at least 21 at pick-up and show a full, valid licence held for at least one year.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Payment and deposit",
              "text": "You pay the rental total at pick-up with a card in the driver's name. A refundable deposit, shown on each class, is held on the card and released when the car comes back in good order.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Coverage",
              "text": "Basic coverage is included and meets the legal minimum, with the deposit as your excess for damage to the car. Full coverage removes the excess, tires and windscreen included.",
              "link": "",
              "label": ""
            }
          ]
        },
        {
          "id": "btppbet46r",
          "type": "faq",
          "source": "",
          "hidden": false,
          "kicker": "",
          "title": "On the road",
          "text": "",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
          "items": [
            {
              "icon": "",
              "media": "",
              "title": "Fuel",
              "text": "Cars leave with a full tank and should come back full. Missing fuel is charged at $9.50 for each eighth of a tank.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Mileage",
              "text": "200 miles a day are included. Each extra mile costs $0.35.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Smoking and pets",
              "text": "No smoking in any car. Pets are welcome in a travel crate. A car that needs extra cleaning is charged $75.",
              "link": "",
              "label": ""
            }
          ]
        },
        {
          "id": "bdcmuzifzi",
          "type": "faq",
          "source": "",
          "hidden": false,
          "kicker": "",
          "title": "Returns and changes",
          "text": "",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
          "items": [
            {
              "icon": "",
              "media": "",
              "title": "Rental days",
              "text": "A rental day is 24 hours from the pick-up time. There is a 59-minute grace time on return; after that a new day starts.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Late returns",
              "text": "Each started day after the booked return is charged at the daily rate. If you need the car longer, ask on Manage booking and we confirm if the car is free.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Damage",
              "text": "We inspect the car with you at pick-up and again at return, with photos. New damage is charged up to the deposit, or nothing with full coverage.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Cancellation",
              "text": "Cancel free of charge on Manage booking until 24 hours before pick-up. After that, please call the branch.",
              "link": "",
              "label": ""
            }
          ]
        }
      ],
